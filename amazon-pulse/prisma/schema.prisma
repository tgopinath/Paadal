// Amazon Pulse — PostgreSQL schema.
// product_snapshots is append-only and range-partitioned by month
// (see db/partitioning.sql, applied after the initial migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSource {
  demo
  pa_api
  sp_api
  licensed
  csv
}

/// How a value was obtained. Verified sales never mix with estimates.
enum Confidence {
  verified  // your own sales, from SP-API
  observed  // listing data as returned by a source (price, BSR, rating)
  estimated // modelled values (demand index, provider unit estimates)
}

enum AlertType {
  price_below
  rank_better_than
  trend_score_above
  demand_change_above
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String?
  email        String        @unique
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  sessions     Session[]
  watchlists   Watchlist[]
  alerts       Alert[]
  reports      UserReport[]
  costProfiles CostProfile[]

  @@map("users")
}

model Session {
  id        String   @id // random 256-bit token, stored hashed
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Category {
  id             String     @id // slug, e.g. "home-kitchen"
  name           String
  parentId       String?    @map("parent_category")
  amazonNodeId   String?    @map("amazon_node_id")
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]

  @@map("categories")
}

model Product {
  id          String            @id @default(uuid()) @db.Uuid
  asin        String
  marketplace String            @default("IN") // Amazon.in
  title       String
  brand       String?
  categoryId  String?           @map("category_id")
  subcategory String?
  imageUrl    String?           @map("image_url")
  amazonUrl   String?           @map("amazon_url")
  firstSeen   DateTime          @default(now()) @map("first_seen") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  category    Category?         @relation(fields: [categoryId], references: [id])
  snapshots   ProductSnapshot[]
  watchedIn   WatchlistProduct[]
  alerts      Alert[]

  @@unique([marketplace, asin])
  @@index([categoryId])
  @@index([brand])
  @@map("products")
}

/// One observation of one product. Nullable fields mean "source did not
/// provide it", never zero. Partitioned by month on captured_at.
model ProductSnapshot {
  id               BigInt     @default(autoincrement())
  productId        String     @map("product_id") @db.Uuid
  capturedAt       DateTime   @map("captured_at") @db.Timestamptz
  capturedDate     DateTime   @map("captured_date") @db.Date // IST calendar date
  price            Decimal?   @db.Decimal(12, 2)
  listPrice        Decimal?   @map("list_price") @db.Decimal(12, 2)
  rating           Decimal?   @db.Decimal(2, 1)
  reviewCount      Int?       @map("review_count")
  bestSellersRank  Int?       @map("best_sellers_rank")
  bsrCategory      String?    @map("bsr_category")
  estimatedDemand  Decimal?   @map("estimated_demand") @db.Decimal(5, 1) // index 0–100
  estimatedUnits   Int?       @map("estimated_units") // provider estimate, labelled as such
  verifiedUnits    Int?       @map("verified_units") // own sales only (SP-API)
  dataSource       DataSource @map("data_source")
  sourceConfidence Confidence @map("source_confidence")
  ingestionRunId   String?    @map("ingestion_run_id") @db.Uuid
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([id, capturedAt]) // partition key must be part of the primary key
  @@unique([productId, capturedDate, dataSource, capturedAt])
  @@index([productId, capturedAt(sort: Desc)])
  @@index([capturedDate, estimatedDemand(sort: Desc)])
  @@map("product_snapshots")
}

/// Every collection job, so freshness and gaps can be reported honestly.
model IngestionRun {
  id          String     @id @default(uuid()) @db.Uuid
  source      DataSource
  startedAt   DateTime   @default(now()) @map("started_at") @db.Timestamptz
  finishedAt  DateTime?  @map("finished_at") @db.Timestamptz
  status      String // running | succeeded | partial | failed
  productsOk  Int        @default(0) @map("products_ok")
  productsErr Int        @default(0) @map("products_err")
  error       String?

  @@index([source, startedAt(sort: Desc)])
  @@map("ingestion_runs")
}

model Watchlist {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  name      String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  WatchlistProduct[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistProduct {
  id          String    @id @default(uuid()) @db.Uuid
  watchlistId String    @map("watchlist_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, productId])
  @@map("watchlist_products")
}

model Alert {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  alertType       AlertType @map("alert_type")
  threshold       Decimal   @db.Decimal(12, 2)
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime? @map("last_triggered_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId, enabled])
  @@map("alerts")
}

model UserReport {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  reportType String   @map("report_type")
  dateStart  DateTime @map("date_start") @db.Date
  dateEnd    DateTime @map("date_end") @db.Date
  filters    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_reports")
}

/// A seller's own cost inputs for the profit calculator.
model CostProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  purchaseCost  Decimal  @map("purchase_cost") @db.Decimal(12, 2)
  purchaseGst   Decimal  @map("purchase_gst_pct") @db.Decimal(4, 2)
  shipping      Decimal  @db.Decimal(12, 2)
  packaging     Decimal  @db.Decimal(12, 2)
  other         Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal? @map("selling_price") @db.Decimal(12, 2)
  claimsItc     Boolean  @default(true) @map("claims_itc")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cost_profiles")
}
