# ---------------------------------------------------------------------------
# Amazon Pulse — environment variables
# Copy to .env.local for development. In production set these in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment
# Variables) or a secrets manager. Never commit real values.
# ---------------------------------------------------------------------------

# demo        → synthetic, clearly labelled demo dataset (default)
# production  → real data only; demo data is refused
APP_MODE=demo

# PostgreSQL (required when APP_MODE=production; enables accounts and CSV import)
DATABASE_URL=postgresql://user:password@host:5432/amazon_pulse?sslmode=require
# Connections per server instance (default 5). Use a pooled URL on serverless hosts.
DATABASE_POOL_MAX=5

# Protects the scheduled job at /api/ingest (Vercel Cron sends it automatically).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Amazon Pulse AI (Claude). Questions per user per hour (default 30).
ANTHROPIC_API_KEY=
AI_QUESTIONS_PER_HOUR=30

# Amazon Product Advertising API 5.0 (Amazon.in)
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.in

# Amazon Selling Partner API (your own seller account)
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_MARKETPLACE_ID=A21TJRUUN4KGV
SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# Licensed product-research provider (optional)
RESEARCH_API_PROVIDER=
RESEARCH_API_KEY=
